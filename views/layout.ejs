<!DOCTYPE html>
<html lang="en" class="govuk-template govuk-template--rebranded">

<head>
    <meta charset="utf-8">
    <title><% if (typeof pageTitle != 'undefined' && pageTitle) { %><%=pageTitle%><%}%></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#1d70b8">
    <link rel="icon" sizes="48x48" href="/assets/rebrand/images/favicon.ico">
    <link rel="icon" sizes="any" href="/assets/rebrand/images/favicon.svg" type="image/svg+xml">
    <link rel="mask-icon" href="/assets/rebrand/images/govuk-icon-mask.svg" color="#1d70b8">
    <link rel="apple-touch-icon" href="/assets/rebrand/images/govuk-icon-180.png">
    <link rel="manifest" href="/assets/rebrand/manifest.json">
    <link rel="stylesheet" href="/stylesheets/govuk-frontend.min.css">
    <link rel="stylesheet" href="/stylesheets/noPrint.css">
</head>

<body class="govuk-template__body">
<script>
    document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');
</script>

<%- include('partials/header') %>

<%- body %>

<%- include('partials/footer') %>

<script type="module" src="/javascripts/govuk-frontend.min.js"></script>
<script type="module">
    import {
        initAll
    } from '/javascripts/govuk-frontend.min.js'
    initAll()
</script>
</body>

<script>
    (function () {
        function hasUsageConsent () {
            try {
                var c = window.GOVUK && GOVUK.getConsentCookie ? GOVUK.getConsentCookie() : null;
                return !!(c && c.usage === true);
            } catch (e) {
                return false;
            }
        }

        if (!hasUsageConsent()) return;

        window._paq = window._paq || [];
        var u = "https://web-analytics.fco.gov.uk/piwik/";

        _paq.push(["setDomains", ["*.verifyapostille.service.gov.uk"]]);
        _paq.push(["enableLinkTracking"]);
        _paq.push(["setTrackerUrl", u + "piwik.php"]);
        _paq.push(["setSiteId", <%= sails.config.piwikID %>]);
        _paq.push(["trackPageView"]);

        var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
        g.async = true; g.defer = true; g.src = u + 'piwik.js';
        s.parentNode.insertBefore(g, s);
    })();
</script>
</html>