{
  "name": "verifyApostille",
  "private": true,
  "version": "0.0.1",
  "description": "FCO Verify Apostille Service",
  "keywords": [],
  "dependencies": {
    "dotenv": "^16.4.7",
    "ejs": "3.1.10",
    "govuk-frontend": "^6.0.0",
    "moment": "^2.30.1",
    "rc": "^1.2.8",
    "sails": "^1.5.14",
    "sails-hook-orm": "^4.0.3",
    "sails-postgresql": "^5.0.1",
