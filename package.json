    "type": "git",
    "url": "git://github.com/jshields/verifyApostille.git"
  },
  "author": "jshields",
  "license": "",
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "chai": "^4.3.8",
    "mocha": "^10.4.0",
    "nodemon": "^3.1.9",
    "supertest": "^6.3.3",
    "xunit-file": "^2.0.1"
  },
  "overrides": {
    "body-parser": "^1.20.6",
    "brace-expansion": "^2.0.2",
    "diff": "^8.0.3",
    "qs": "^6.14.1",
    "serialize-javascript": "^7.0.3",
    "minimatch": "^3.1.5",
    "underscore": "^1.13.8"
  }
